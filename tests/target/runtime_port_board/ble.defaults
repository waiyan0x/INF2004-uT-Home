# Isolated nonconnectable advertising diagnostic; no NVS or Wi-Fi.
CONFIG_FREERTOS_HZ=1000
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_PINNED_TO_CORE=0
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_BLE_CCA_MODE_HW=y
CONFIG_BT_BLE_CCA_MODE=1
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
# ESP_WIFI_ENABLED is an SDK capability symbol without a user prompt. Isolation
# is checked from linked entry points; this probe never initializes Wi-Fi.
