# Opt-in experimental real services; no static/coexistence acceptance claim.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
# MQTT reconnects use full verified handshakes; no saved session is reused.
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=n
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS=n
CONFIG_LWIP_SO_REUSE=n
