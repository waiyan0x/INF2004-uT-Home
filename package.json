{
  "name": "uthome-host-checks",
  "private": true,
  "scripts": {
    "lint": "eslint tools/configurator/static tools/wiring_visualiser tests/target tests/browser --max-warnings 0",
    "test": "node --test tests/target/test_*.mjs tools/wiring_visualiser/tests/*.test.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  }
}
