# BARR-C requires LF source lines on every developer platform.
*.c text eol=lf whitespace=-blank-at-eof
*.h text eol=lf whitespace=-blank-at-eof
.clang-format text eol=lf
# Preserve committed patch bytes and the host/target dependency licence check.
firmware/third_party/patches/*.patch text eol=lf
firmware/third_party/cjson/LICENSE text eol=lf
