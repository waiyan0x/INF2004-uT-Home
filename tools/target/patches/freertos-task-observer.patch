+                if (self == &s_tasks[i] &&
+                    s_cleanup_pending[i] == SHIM_CLEANUP_NONE) {
+                    s_cleanup_pending[i] = SHIM_CLEANUP_PENDING;
+                    break;
+                }
+            }
+
+            EI(saved);
+        }
+
         tk_ext_tsk();
         return;
     }
+
+    /*
+     * Explicit deletion is not yet qualified for deferred reclamation.
+     * Do not free task resources without verified termination.
+     */
     shim_task_t *entry = find_by_handle(h);
-    if (!entry || entry->tsk_id == 0) return;
-
-    tk_ter_tsk(entry->tsk_id);
-    tk_del_tsk(entry->tsk_id);
-    tk_del_sem(entry->notify_sem);
-    if (entry->stack) { heap_caps_free(entry->stack); entry->stack = NULL; }
-    entry->tsk_id     = 0;
-    entry->notify_sem = 0;
+
+    if (entry == NULL)
+        return;
+
+    UINT saved;
+    int index = -1;
+    ID id = 0;
+
+    DI(saved);
+
+    for (int i = 0; i < SHIM_TASK_MAX; i++) {
+        if (entry == &s_tasks[i] &&
+            entry->tsk_id > 0 &&
+            s_cleanup_pending[i] == SHIM_CLEANUP_NONE) {
+            s_cleanup_pending[i] = SHIM_CLEANUP_CLAIMED;
+            index = i;
+            id = entry->tsk_id;
+            break;
+        }
+    }
+
+    EI(saved);
+
+    if (index < 0)
+        return;
+
+    T_RTSK state;
+    ER result = tk_ref_tsk(id, &state);
+
+    if (result == E_OK && state.tskstat != TTS_DMT)
+        result = tk_ter_tsk(id);
+
+    /*
+     * Keep the slot reserved for deferred cleanup.
+     * The reaper must confirm dormancy before deleting resources.
+     * A failed termination does not imply that the task has stopped.
+     */
+    DI(saved);
+    s_cleanup_pending[index] = SHIM_CLEANUP_PENDING;
+    EI(saved);
 }
 
