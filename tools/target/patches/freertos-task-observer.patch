+/*
+ * Reclaim at most one self-deleted task per call.
+ * Must run from a surviving task, never from an ISR or the dying task.
+ * Returns 1 if reclaimed, 0 if none ready, -1 on cleanup failure.
+ */
+/*
+ * Attempt to reclaim one self-deleted task.
+ * Must be invoked from a surviving task context.
+ */
+int shim_task_reap_one(void)
+{
+    for (int i = 0; i < SHIM_TASK_MAX; i++) {
+        UINT saved;
+        ID id;
+        uint8_t phase;
+
+        DI(saved);
+        phase = s_cleanup_pending[i];
+
+        if (phase != SHIM_CLEANUP_PENDING &&
+            phase != SHIM_CLEANUP_TASK_DELETED &&
+            phase != SHIM_CLEANUP_SEM_DELETED) {
+            EI(saved);
+            continue;
+        }
+
+        if (phase == SHIM_CLEANUP_PENDING) {
+            s_cleanup_pending[i] = SHIM_CLEANUP_CLAIMED;
+        } else if (phase == SHIM_CLEANUP_TASK_DELETED) {
+            s_cleanup_pending[i] = SHIM_CLEANUP_CLAIMED_TASK_DELETED;
+        } else {
+            s_cleanup_pending[i] = SHIM_CLEANUP_CLAIMED_SEM_DELETED;
+        }
+
+        id = s_tasks[i].tsk_id;
+        EI(saved);
+
+        if (phase == SHIM_CLEANUP_PENDING) {
+            T_RTSK state;
+
+            if (id <= 0 || tk_ref_tsk(id, &state) != E_OK) {
+                DI(saved);
+                s_cleanup_pending[i] = SHIM_CLEANUP_PENDING;
+                EI(saved);
+                return -1;
+            }
+
+            if (state.tskstat != TTS_DMT) {
+                DI(saved);
+                s_cleanup_pending[i] = SHIM_CLEANUP_PENDING;
+                EI(saved);
+                continue;
+            }
+
+            if (tk_del_tsk(id) != E_OK) {
+                DI(saved);
+                s_cleanup_pending[i] = SHIM_CLEANUP_PENDING;
+                EI(saved);
+                return -1;
+            }
+
+            phase = SHIM_CLEANUP_TASK_DELETED;
+        }
+
+        if (phase == SHIM_CLEANUP_TASK_DELETED) {
+            if (s_tasks[i].notify_sem > 0) {
+                if (tk_del_sem(s_tasks[i].notify_sem) != E_OK) {
+                    DI(saved);
+                    s_cleanup_pending[i] = SHIM_CLEANUP_TASK_DELETED;
+                    EI(saved);
+                    return -1;
+                }
+
+                s_tasks[i].notify_sem = 0;
+            }
+
+            phase = SHIM_CLEANUP_SEM_DELETED;
+        }
+
+        if (phase == SHIM_CLEANUP_SEM_DELETED) {
+            if (s_tasks[i].stack != NULL) {
+                heap_caps_free(s_tasks[i].stack);
+                s_tasks[i].stack = NULL;
+            }
+
+            s_tasks[i].stack_sz = 0;
+
+            if (c3task_observer_release((void *)&s_tasks[i]) != 0) {
+                DI(saved);
+                s_cleanup_pending[i] = SHIM_CLEANUP_SEM_DELETED;
+                EI(saved);
+                return -1;
+            }
+
+            DI(saved);
+            s_tasks[i].tsk_id = 0;
+            s_cleanup_pending[i] = SHIM_CLEANUP_NONE;
+            EI(saved);
+
+            return 1;
+        }
+    }
+
+    return 0;
+}
