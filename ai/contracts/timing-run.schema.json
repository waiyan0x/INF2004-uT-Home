{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uthome:timing-run:0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "version", "experiment_sha256", "interval_ms", "repetition", "origin", "method", "firmware_sha256", "identity_evidence_sha256", "session_id", "sample_interval_ms", "samples"],
  "properties": {
    "contract": {"const": "uthome.timing-run"}, "version": {"const": "0.1.0"},
    "experiment_sha256": {"$ref": "#/$defs/hash"},
    "interval_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
    "repetition": {"type": "integer", "minimum": 0, "maximum": 9},
    "origin": {"enum": ["simulated", "hardware"]},
    "method": {"enum": ["simulator-v1", "telemetry_sample_age", "external_visible_delay"]},
    "firmware_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "identity_evidence_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "session_id": {"$ref": "#/$defs/name"},
    "sample_interval_ms": {"type": "integer", "minimum": 20, "maximum": 1000},
    "samples": {
      "type": "array", "minItems": 2, "maxItems": 40000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["elapsed_ms", "uptime_ms", "session_id", "profile_sha256", "metric_ms", "quality", "health_faults"],
        "properties": {
          "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 660000},
          "uptime_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "session_id": {"$ref": "#/$defs/name"},
          "profile_sha256": {"$ref": "#/$defs/hash"},
          "metric_ms": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 1000000}]},
          "quality": {"enum": ["fresh", "stale", "missing", "fault"]},
          "health_faults": {"type": "integer", "minimum": 0, "maximum": 4294967295}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}
  }
}
